{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lart",
      "camelcase": "Lart",
      "title": "Lart",
      "scope": "source.lart",
      "file-types": [
        "lart"
      ],
      "injection-regex": "^lart$",
      "class-name": "TreeSitterLart"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Lart grammar for tree-sitter",
    "authors": [
      {
        "name": "frefolli"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-lart"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}